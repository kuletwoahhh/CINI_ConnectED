PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=connected_system
JWT_SECRET=change_me

# iTexMo API v5 (default), semaphore, philsms, or smsgate
SMS_PROVIDER=itexmo
SMS_API_KEY=
ITEXMO_EMAIL=
ITEXMO_PASSWORD=
SMS_SENDER=
SMS_DRY_RUN=true
SMS_POLL_MS=60000
SMS_MAX_ATTEMPTS=5

# SMSGate Android gateway. Set SMS_PROVIDER=smsgate and fill both credentials.
# Keep SMS_DRY_RUN=true until those credentials work. Restart the server after changing them.
# Cloud default is below. For a phone on the same network use http://192.168.x.x:8080
# SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
# SMSGATE_USERNAME=
# SMSGATE_PASSWORD=

# --- AI lesson recommendations (OpenAI) ---
# Leave OPENAI_API_KEY empty or AI_DRY_RUN=true to use mock drafts (no API call).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DRY_RUN=true

# Account emails. The account is still created when these are empty or the provider rejects the message.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ConnectED <school@example.com>"

# Path routing (/login, /admin, /teacher, /parent). Off keeps the current single-page URLs.
ROUTING_V2_ENABLED=false
